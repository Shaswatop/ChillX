# ─────────────────────────────────────────────────────────────
# ChillX environment variables
#
# Copy this file to `.env` for LOCAL development (the app also
# works with no .env at all — dev defaults kick in).
#
# On Render, set these in the dashboard / render.yaml — Render
# injects DATABASE_URL, REDIS_URL and PORT automatically.
# ─────────────────────────────────────────────────────────────

# ── Core Django ──
# Generate one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# REQUIRED in production. Dev falls back to an insecure key.
DJANGO_SECRET_KEY=generate-a-random-secret-key

# "True" (default) for local dev. Set to "False" in production.
DEBUG=True

# Comma-separated list of allowed hosts.
# Dev default: * (anything, e.g. cloudflared tunnel).
# Production example: chillx.onrender.com,www.chillx.onrender.com
ALLOWED_HOSTS=*

# Comma-separated origins allowed to POST CSRF-authenticated requests.
# Production example: https://chillx.onrender.com
CSRF_TRUSTED_ORIGINS=https://*.trycloudflare.com

# ── Database ──
# Production: Render injects DATABASE_URL (PostgreSQL).
# Local dev: leave blank to use SQLite (db.sqlite3).
DATABASE_URL=

# ── Redis (Channels channel layer + cache) ──
# Production: Render injects REDIS_URL.
# Local dev: leave blank to use in-memory channel layer + LocMemCache.
REDIS_URL=

# ── CORS ──
# Comma-separated allowed origins. When set, CORS allow-all is disabled.
# Production example: https://chillx.onrender.com
# Local dev: leave blank → allow-all (works with cloudflared tunnel).
CORS_ALLOWED_ORIGINS=

# ── Optional security hardening (only applied when DEBUG=False) ──
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True

# ── AI API keys (fallbacks; users can also set their own in Settings) ──
# Get your own free keys at:
#   Groq (free):     https://console.groq.com/keys
#   Gemini (free):   https://aistudio.google.com/apikey
#   OpenRouter:      https://openrouter.ai/keys
# OPTIONAL — the app generates challenges & chats locally when no key is set.
GROQ_KEY=your-groq-api-key
GROQ_KEY2=your-groq-api-key-2
GEMINI_KEY=your-gemini-api-key
GEMINI_KEY2=your-gemini-api-key-2
OPENROUTER_KEY=your-openrouter-api-key
OPENROUTER_KEY2=your-openrouter-api-key-2
